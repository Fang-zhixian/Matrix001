# Frontend
VITE_API_BASE_URL="http://localhost:8787"

# Backend runtime
PORT="8787"
APP_DEPLOYMENT_MODE="self-hosted"
APP_ENABLE_BYOK="true"
APP_ALLOW_GUEST="true"

# Supabase / Postgres database connection
# Prefer the Supabase pooled connection string for production.
DATABASE_URL=""
SUPABASE_DB_URL=""

# Optional one-time migration source from the old local SQLite store
APP_LEGACY_SQLITE_PATH="./server/data/matrix001.sqlite"

# Platform-managed credentials
# In SaaS mode, prefer PLATFORM_* so you can keep platform keys
# separate from user-provided or local development credentials.
PLATFORM_GEMINI_API_KEY=""
PLATFORM_DEEPSEEK_API_KEY=""
PLATFORM_QWEN_API_KEY=""
PLATFORM_MOONSHOT_API_KEY=""
PLATFORM_ZHIPU_API_KEY=""

# Shared fallback credentials for self-hosted mode
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""
MOONSHOT_API_KEY=""
ZHIPU_API_KEY=""

# Optional platform-managed base URLs
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
MOONSHOT_BASE_URL="https://api.moonshot.cn/v1"
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# Optional platform-specific base URLs
PLATFORM_DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
PLATFORM_QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
PLATFORM_MOONSHOT_BASE_URL="https://api.moonshot.cn/v1"
PLATFORM_ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
