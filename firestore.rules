rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid is string && 
               data.email is string &&
               (data.displayName == null || data.displayName is string) &&
               (data.photoURL == null || data.photoURL is string) &&
               data.lastLogin is number;
      }

      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      
      // Canvas Rules
      match /canvases/{canvasId} {
        function isValidCanvas(data) {
          return data.id is string &&
                 data.name is string && data.name.size() < 100 &&
                 data.nodes is list &&
                 data.edges is list &&
                 data.createdAt is number &&
                 data.lastModified is number &&
                 data.ownerId == userId;
        }

        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCanvas(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
